PORT=4000

# 1. Paste your Google Gemini API Key here (from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. PostgreSQL Database URL (Local Postgres, Neon.tech, or Supabase)
# Leave blank to use the automatic local file database (database/local_db.json)
DATABASE_URL=postgresql://postgres:password@localhost:5432/ecoserve

# 3. Google OAuth 2.0 Client ID (from https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
